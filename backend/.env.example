# ========================================================
# FidesSystem Environment Variables Template (.env.example)
# Copia este archivo a .env y define tus credenciales reales.
# NUNCA subas el archivo .env a GitHub.
# ========================================================

# Django
DEBUG=False
SECRET_KEY=django-insecure-production-secret-key-change-me-immediately

# Base de datos (Render provee DATABASE_URL automáticamente)
# DATABASE_URL=postgresql://usuario:password@dpg-xxxx.render.com/fidessystem_db
DB_NAME=fidessystem_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura
DB_HOST=localhost
DB_PORT=5432

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS (Frontend permitido en producción)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com
